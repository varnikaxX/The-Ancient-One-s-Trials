# ── copy to backend/.env and `export $(grep -v '^#' .env | xargs)` (or set in your process manager) ──
DATABASE_URL=postgresql://postgres:1234@localhost:5432/ancient_trials
DB_POOL_MIN=2
DB_POOL_MAX=30
REDIS_URL=redis://localhost:6379/0

# MUST be changed in any shared/production deployment
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_MINUTES=720

SLOT_MINUTES=30
CACHE_TTL_SECONDS=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# true = greedy app/services/solver_stub.py ; false = Varnika's `scheduler` package
USE_STUB_SOLVER=false
SOLVER_TIME_LIMIT=20
RESCHEDULE_TIME_LIMIT=10

# Email: leave keys empty + EMAIL_DRY_RUN=true to only log emails (offline demo)
EMAIL_FROM=trials@example.com
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_DRY_RUN=true
PUBLIC_BASE_URL=http://localhost:5173

OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BATCH=50
# true = run Celery tasks inline inside the API (no worker needed; demo only)
CELERY_EAGER=false

# ── Real email (choose ONE) ─────────────────────────────────────────
# A) Gmail SMTP for local demos: needs 2-Step Verification + an App Password (Google Account > Security > App passwords)
#    EMAIL_FROM must be the same Gmail address.
# EMAIL_FROM=you@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop
# B) Resend: RESEND_API_KEY=... (free plan only delivers to your own address unless you verify a domain)
# Leaving everything empty + EMAIL_DRY_RUN=true only LOGS emails in the worker window.
